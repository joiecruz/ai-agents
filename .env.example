# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number (or your approved number)
WHATSAPP_TO=whatsapp:+1234567890             # Your personal WhatsApp number

# Schedule (24h format, local time)
MORNING_HOUR=7
MORNING_MINUTE=0

# Your name (used in the greeting)
YOUR_NAME=Alex
